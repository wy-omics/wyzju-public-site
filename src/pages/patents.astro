---
import Base from '../layouts/Base.astro'
import patents from '../../public-data/patents.json'
import software from '../../public-data/software.json'
import standards from '../../public-data/standards.json'
---
<Base title="Patents & IP" description="Patents, software copyrights, and standards by Wang Yue">
  <style>
    .page-header { margin-bottom: 32px }
    .page-header h1 { font-size: 26px; font-weight: 800; margin-bottom: 6px }
    .page-header p { color: var(--gray); font-size: 14px }
    h2 { font-size: 18px; font-weight: 700; margin: 32px 0 14px; padding-bottom: 8px; border-bottom: 2px solid var(--border) }
    .card-list { display: flex; flex-direction: column; gap: 10px }
    .card {
      background: #fff; border: 1px solid var(--border); border-radius: 8px;
      padding: 14px 16px;
    }
    .card-title { font-size: 14px; font-weight: 600; margin-bottom: 4px; line-height: 1.5 }
    .card-meta { font-size: 12px; color: var(--gray) }
    .badge {
      display: inline-block; padding: 1px 7px; border-radius: 4px;
      font-size: 11px; font-weight: 600; margin-right: 6px;
    }
    .badge-purple { background: #ede9fe; color: #5b21b6 }
    .badge-teal { background: #ccfbf1; color: #065f46 }
  </style>

  <div class="page-header">
    <h1>Patents &amp; IP</h1>
    <p>{patents.length} patents · {software.length} software copyrights · {standards.length} standards</p>
  </div>

  <h2>Patents ({patents.length})</h2>
  <div class="card-list">
    {patents.map((p: any) => (
      <div class="card">
        <div class="card-title">{p.title}</div>
        <div class="card-meta">
          <span class="badge badge-purple">{p.patent_type || 'Patent'}</span>
          {p.patent_number && <span>{p.patent_number} · </span>}
          {p.inventors && p.inventors.slice(0, 6).join(', ')}
          {p.inventors && p.inventors.length > 6 ? ', et al.' : ''}
          {p.grant_date && <span> · Granted {p.grant_date}</span>}
          {!p.grant_date && p.application_date && <span> · Applied {p.application_date}</span>}
        </div>
      </div>
    ))}
  </div>

  <h2>Software Copyrights ({software.length})</h2>
  <div class="card-list">
    {software.map((s: any) => (
      <div class="card">
        <div class="card-title">{s.title}</div>
        <div class="card-meta">
          <span class="badge badge-teal">Software</span>
          {s.registration_number && <span>{s.registration_number} · </span>}
          {s.authors && s.authors.slice(0, 6).join(', ')}
          {s.date && <span> · {s.date.slice(0, 4)}</span>}
        </div>
      </div>
    ))}
  </div>

  {standards.length > 0 && (
    <>
      <h2>Standards ({standards.length})</h2>
      <div class="card-list">
        {standards.map((s: any) => (
          <div class="card">
            <div class="card-title">{s.title}</div>
            <div class="card-meta">
              {s.standard_number && <span>{s.standard_number} · </span>}
              {s.authors && s.authors.slice(0, 6).join(', ')}
            </div>
          </div>
        ))}
      </div>
    </>
  )}
</Base>

---
import Base from '../../layouts/Base.astro'
import papersRaw from '../../../public-data/papers.json'
import patentsRaw from '../../../public-data/patents.json'
import trackerRaw from '../../../public-data/tracker.json'

const active = [
  { type: '国家自然科学基金面上项目', cn: '柑橘内生假单胞菌介导的陈皮关键品质形成及其SoxR–SoxS–zwf轴调控机制', number: '32672846', period: '2027.01~2030.12' },
  { type: '浙江省三农九方项目', cn: '衢橘产业高质量发展关键技术研究与应用', number: '2026SNJF079', period: '2026.01~2027.12' },
  { type: '基本科研业务费重大战略任务培育计划', cn: '植物源生鲜农产品智能保鲜物流与加工关键技术', number: '226-2026-00062', period: '2026.01~2028.12' },
  { type: '浙江省自然科学基金杭州联合基金重大项目', cn: '柑橘风味和营养物质形成的关键基因及其分子调控机制研究', number: 'LHZSD24C150001', period: '2024.01~2026.12' },
  { type: '国家自然科学基金区域联合基金', cn: '柑橘类黄酮生物合成关键基因及其网络调控机制研究', number: 'U25A20688', period: '2026.01~2029.12' },
  { type: '浙江省农业重大技术协同推广计划', cn: '柑橘采后品质维持及高值化利用技术研究与集成推广', number: '2026ZDXT02', period: '2026.01~2027.12' },
  { type: '四川省重点研发省校合作项目', cn: '川红橘现代化加工关键技术创新与高值化陈皮产品研发', number: '2026YFHZ0239', period: '2026.01~2027.12' },
  { type: '北京生命科技研究院合作项目', cn: '烟草源碱性磷酸酶分离纯化关键技术与集成工艺开发', number: '2025-KYY-135000-0004-01', period: '2026.01~2029.12' },
  { type: '北京生命科技研究院合作项目', cn: '基于能量与代谢流协同优化的烟草多模态合成底盘构建', number: '2025-KYY-135000-0004-05', period: '2026.01~2028.12' },
  { type: '横向项目', cn: '衢州柑橘果实风味和营养评价研究', number: '2025-KYY-600101-0017', period: '2026.01~2026.12' },
  { type: '台州研究院合作项目', cn: '特色果蔬高值化利用开发', number: 'TBD-TZYJY', period: '2026.01~2027.12' },
]

const paperMap: Record<string, any> = {}
for (const p of papersRaw as any[]) paperMap[p.id] = p

const patentMap: Record<string, any> = {}
for (const p of patentsRaw as any[]) patentMap[p.id] = p

const tracker: Record<string, any> = {}
for (const t of trackerRaw as any[]) tracker[t.project_number] = t

function fundOrderLabel(order: number): string {
  return `第${order}标注`
}
function fundOrderClass(order: number): string {
  if (order === 1) return 'badge-fund1'
  if (order === 2) return 'badge-fund2'
  return 'badge-fundn'
}

function authorPos(paper: any): string {
  const name = 'Wang Yue'
  const isCorr = paper.is_corresponding === true
  const isCoFirst = paper.is_co_first === true || (paper.co_first_authors && paper.co_first_authors.includes(name))
  const idx = paper.authors ? paper.authors.indexOf(name) : -1
  const isFirst = idx === 0
  if (isFirst && isCoFirst && isCorr) return '共一/通讯'
  if (isFirst && isCorr) return '第一/通讯'
  if (isCoFirst && isCorr) return '共一/通讯'
  if (isCorr) return '通讯'
  if (isCoFirst) return '共同第一'
  if (isFirst) return '第一'
  if (idx > 0) return `第${idx + 1}`
  return '参与'
}

function posColor(pos: string): string {
  if (pos.includes('通讯') || pos.includes('第一')) return '#1e40af|#dbeafe'
  return '#374151|#f3f4f6'
}

function resolveYear(dateStr: string): string {
  return dateStr ? dateStr.slice(0, 4) : ''
}
---
<Base title="项目进度" description="王岳在研项目执行进度追踪">
  <style>
    .page-header { margin-bottom: 24px }
    .page-header h1 { font-size: 26px; font-weight: 800; margin-bottom: 4px }
    .page-header p { color: var(--gray); font-size: 13px }

    /* accordion */
    details { margin-bottom: 10px; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.04) }
    details[open] { box-shadow: 0 2px 8px rgba(0,0,0,.08) }

    summary {
      list-style: none;
      cursor: pointer;
      padding: 14px 18px;
      border-bottom: 2px solid transparent;
      transition: border-color .15s;
      user-select: none;
    }
    summary::-webkit-details-marker { display: none }
    details[open] > summary { border-bottom-color: #1d4ed8 }
    summary:hover { background: #fafafa }

    .sum-top { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; flex-wrap: wrap }
    .tag-type { font-size: 11px; font-weight: 700; color: #1e40af; background: #dbeafe; padding: 2px 8px; border-radius: 4px }
    .tag-period { font-size: 11px; font-weight: 600; color: #fff; background: #059669; padding: 2px 8px; border-radius: 4px }
    .sum-right { margin-left: auto; display: flex; flex-direction: column; gap: 4px; align-items: flex-end }
    .sum-counts { display: flex; gap: 6px; align-items: center }
    .count-chip { font-size: 11px; font-weight: 600; padding: 1px 7px; border-radius: 10px; background: #f3f4f6; color: #6b7280 }
    .count-chip.has { background: #eff6ff; color: #1d4ed8 }
    .chevron { margin-left: 8px; font-size: 12px; color: #9ca3af; transition: transform .2s; flex-shrink: 0 }
    details[open] .chevron { transform: rotate(180deg) }

    .proj-title { font-size: 14px; font-weight: 700; color: #111827; line-height: 1.5 }
    .proj-num { font-size: 11px; color: var(--gray); font-family: monospace; margin-top: 2px }

    .section { border-top: 1px solid var(--border) }
    .section > summary {
      list-style: none;
      cursor: pointer;
      user-select: none;
      padding: 8px 18px;
      border-bottom: none !important;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .section > summary::-webkit-details-marker { display: none }
    .section > summary:hover { background: #f9fafb }
    .section[open] > summary { border-bottom: none }
    .sec-label { font-size: 11px; font-weight: 700; color: #9ca3af; text-transform: uppercase; letter-spacing: .06em }
    .sec-toggle { margin-left: auto; font-size: 11px; color: #d1d5db; transition: transform .15s }
    .section:not([open]) > summary .sec-toggle { transform: rotate(-90deg) }
    .sec-body { padding: 4px 18px 12px }

    .paper-row { display: flex; flex-direction: column; gap: 2px; margin-bottom: 10px; padding-bottom: 10px; border-bottom: 1px solid #f3f4f6 }
    .paper-row:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: none }
    .paper-title-text { font-size: 13px; color: #111827; line-height: 1.55; font-weight: 500 }
    .paper-title-text a { color: #111827 }
    .paper-title-text a:hover { color: var(--blue) }
    .paper-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 5px; margin-top: 4px }
    .meta-journal { font-size: 12px; color: var(--gray); font-style: italic }
    .meta-year { font-size: 11px; color: #9ca3af }

    .badge { display: inline-block; font-size: 11px; font-weight: 600; padding: 1px 6px; border-radius: 3px; white-space: nowrap }
    .badge-if  { background: #fef3c7; color: #92400e }
    .badge-if5 { background: #fef9c3; color: #713f12 }
    .badge-pos-hi { background: #dbeafe; color: #1e40af }
    .badge-pos    { background: #f3f4f6; color: #374151 }
    .badge-pub    { background: #dcfce7; color: #166534 }
    .badge-review { background: #fef9c3; color: #92400e }
    .badge-draft  { background: #e0f2fe; color: #075985 }
    .badge-marked   { background: #d1fae5; color: #166534 }
    .badge-unmarked { background: #fef3c7; color: #92400e }
    .badge-granted  { background: #dcfce7; color: #166534 }
    .badge-exam     { background: #e0f2fe; color: #075985 }
    .badge-filed    { background: #fef9c3; color: #92400e }
    .badge-fund1    { background: #fef3c7; color: #78350f; font-weight: 700 }
    .badge-fund2    { background: #fef9c3; color: #92400e }
    .badge-fundn    { background: #f3f4f6; color: #6b7280 }
    .count-chip.done { background: #dcfce7; color: #166534 }

    .patent-row { display: flex; align-items: flex-start; gap: 8px; margin-bottom: 8px; font-size: 13px }
    .patent-row:last-child { margin-bottom: 0 }
    .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--blue); flex-shrink: 0; margin-top: 6px }

    .student-row { display: flex; align-items: center; gap: 8px; font-size: 13px; margin-bottom: 6px }
    .student-row:last-child { margin-bottom: 0 }
    .student-name { font-weight: 600 }
    .student-meta { color: var(--gray); font-size: 12px }

    .notes-text { font-size: 13px; color: #374151; line-height: 1.7 }
    .milestone-row { display: flex; gap: 10px; font-size: 13px; margin-bottom: 5px }
    .mdate { font-size: 11px; font-family: monospace; color: var(--gray); white-space: nowrap; padding-top: 2px }
    .empty { font-size: 12px; color: #d1d5db; font-style: italic }
  </style>

  <div class="page-header">
    <h1>项目进度追踪</h1>
  </div>

  {active.map(proj => {
    const t = tracker[proj.number] || {}
    const papersRaw2: any[] = (t.papers || []).slice().sort((a: any, b: any) => (a.fund_order || 99) - (b.fund_order || 99))
    const patents: any[] = t.patents || []
    const students: any[] = t.students || []
    const milestones: any[] = t.milestones || []
    const notes: string = t.notes || ''
    const targetPapers: number | null = t.target_papers ?? null
    const targetPatents: number | null = t.target_patents ?? null
    const paperCount = papersRaw2.length
    const patentCount = patents.length
    const targetStudents: number | null = t.target_students ?? null
    const targetSoftwares: number | null = t.target_softwares ?? null
    const targetStandards: number | null = t.target_standards ?? null
    const targetDatabases: number | null = t.target_databases ?? null
    const targetProducts: number | null = t.target_products ?? null
    const targetByproducts: number | null = t.target_byproducts ?? null
    const targetMajorProjects: number | null = t.target_major_projects ?? null
    const targetTransfers: number | null = t.target_transfers ?? null
    const softwares: any[] = t.softwares || []
    const standards: any[] = t.standards || []
    const databases: any[] = t.databases || []
    const products: any[] = t.products || []
    const byproducts: any[] = t.byproducts || []
    const majorProjects: any[] = t.major_projects || []
    const transfers: any[] = t.transfers || []
    const paperDone = targetPapers !== null && paperCount >= targetPapers
    const patentDone = targetPatents !== null && patentCount >= targetPatents
    const studentDone = targetStudents !== null && students.length >= targetStudents
    const showStudents = students.length > 0 || targetStudents !== null
    const showSoftwares = softwares.length > 0 || targetSoftwares !== null
    const showStandards = standards.length > 0 || targetStandards !== null
    const showDatabases = databases.length > 0 || targetDatabases !== null
    const showProducts = products.length > 0 || targetProducts !== null
    const showByproducts = byproducts.length > 0 || targetByproducts !== null
    const showMajorProjects = majorProjects.length > 0 || targetMajorProjects !== null
    const showTransfers = transfers.length > 0 || targetTransfers !== null

    return (
      <details>
        <summary>
          <div class="sum-top">
            <span class="tag-type">{proj.type}</span>
            <span class="tag-period">{proj.period}</span>
            <div class="sum-right">
              <div class="sum-counts">
                <span class={`count-chip${paperCount ? ' has' : ''}${paperDone ? ' done' : ''}`}>
                  论文 {paperCount}{targetPapers !== null ? `/${targetPapers}` : ''}
                </span>
                <span class={`count-chip${patentCount ? ' has' : ''}${patentDone ? ' done' : ''}`}>
                  专利 {patentCount}{targetPatents !== null ? `/${targetPatents}` : ''}
                </span>
                {showStudents && (
                  <span class={`count-chip${students.length ? ' has' : ''}${studentDone ? ' done' : ''}`}>
                    研究生 {students.length}{targetStudents !== null ? `/${targetStudents}` : ''}
                  </span>
                )}
                <span class="chevron">▼</span>
              </div>
              {(showSoftwares || showStandards || showDatabases || showProducts || showByproducts || showMajorProjects || showTransfers) && (
                <div class="sum-counts">
                  {showSoftwares && (
                    <span class={`count-chip${softwares.length ? ' has' : ''}${softwares.length >= (targetSoftwares ?? Infinity) ? ' done' : ''}`}>
                      软著 {softwares.length}{targetSoftwares !== null ? `/${targetSoftwares}` : ''}
                    </span>
                  )}
                  {showStandards && (
                    <span class={`count-chip${standards.length ? ' has' : ''}${standards.length >= (targetStandards ?? Infinity) ? ' done' : ''}`}>
                      标准 {standards.length}{targetStandards !== null ? `/${targetStandards}` : ''}
                    </span>
                  )}
                  {showDatabases && (
                    <span class={`count-chip${databases.length ? ' has' : ''}${databases.length >= (targetDatabases ?? Infinity) ? ' done' : ''}`}>
                      数据库 {databases.length}{targetDatabases !== null ? `/${targetDatabases}` : ''}
                    </span>
                  )}
                  {showProducts && (
                    <span class={`count-chip${products.length ? ' has' : ''}${products.length >= (targetProducts ?? Infinity) ? ' done' : ''}`}>
                      产品 {products.length}{targetProducts !== null ? `/${targetProducts}` : ''}
                    </span>
                  )}
                  {showByproducts && (
                    <span class={`count-chip${byproducts.length ? ' has' : ''}${byproducts.length >= (targetByproducts ?? Infinity) ? ' done' : ''}`}>
                      副产物 {byproducts.length}{targetByproducts !== null ? `/${targetByproducts}` : ''}
                    </span>
                  )}
                  {showMajorProjects && (
                    <span class={`count-chip${majorProjects.length ? ' has' : ''}${majorProjects.length >= (targetMajorProjects ?? Infinity) ? ' done' : ''}`}>
                      重大任务 {majorProjects.length}{targetMajorProjects !== null ? `/${targetMajorProjects}` : ''}
                    </span>
                  )}
                  {showTransfers && (
                    <span class={`count-chip${transfers.length ? ' has' : ''}${transfers.length >= (targetTransfers ?? Infinity) ? ' done' : ''}`}>
                      成果转化 {transfers.length}{targetTransfers !== null ? `/${targetTransfers}` : ''}
                    </span>
                  )}
                </div>
              )}
            </div>
          </div>
          <div class="proj-title">{proj.cn}</div>
          {!proj.number.startsWith('TBD') && <div class="proj-num">{proj.number}</div>}
        </summary>

        {/* Papers */}
        <details class="section" open>
          <summary class="sec-label">论文 ({paperCount}{targetPapers !== null ? `/${targetPapers}` : ''})<span class="sec-toggle">▾</span></summary>
          <div class="sec-body">
          {papersRaw2.length > 0 ? papersRaw2.map((entry: any) => {
            const p = entry.paper_id ? paperMap[entry.paper_id] : null
            const title = p ? p.title : (entry.title || '（未命名）')
            const doi = p ? p.doi : entry.doi
            const journal = p ? p.journal : (entry.journal || '')
            const year = p ? resolveYear(p.date) : (entry.year || '')
            const jif = p ? p.jif : entry.jif
            const if5val = p ? p.if5 : entry.if5
            const pos = p ? authorPos(p) : ''
            const posIsKey = pos.includes('通讯') || pos.includes('第一')
            const status: string = entry.status || (p ? '已发表' : '')
            const statusClass = status === '已发表' ? 'badge-pub' : status === '在审' ? 'badge-review' : 'badge-draft'
            const fundMarked: boolean | undefined = entry.fund_marked
            const fundOrder: number | undefined = entry.fund_order
            return (
              <div class="paper-row">
                <div class="paper-title-text" set:html={doi
                  ? `<a href="https://doi.org/${doi}" target="_blank" rel="noopener">${title}</a>`
                  : title} />
                <div class="paper-meta">
                  {journal && <span class="meta-journal">{journal}</span>}
                  {year && <span class="meta-year">{year}</span>}
                  {jif != null && <span class="badge badge-if">IF {jif}</span>}
                  {if5val != null && <span class="badge badge-if5">IF5 {if5val}</span>}
                  {pos && <span class={`badge ${posIsKey ? 'badge-pos-hi' : 'badge-pos'}`}>{pos}</span>}
                  {fundOrder !== undefined && (
                    <span class={`badge ${fundOrderClass(fundOrder)}`}>{fundOrderLabel(fundOrder)}</span>
                  )}
                  {status && <span class={`badge ${statusClass}`}>{status}</span>}
                  {fundMarked !== undefined && (
                    <span class={`badge ${fundMarked ? 'badge-marked' : 'badge-unmarked'}`}>
                      {fundMarked ? '已标注' : '待标注'}
                    </span>
                  )}
                </div>
              </div>
            )
          }) : <div class="empty">暂无关联论文</div>}
          </div>
        </details>

        {/* Patents */}
        <details class="section" open>
          <summary class="sec-label">专利 ({patents.length}{targetPatents !== null ? `/${targetPatents}` : ''})<span class="sec-toggle">▾</span></summary>
          <div class="sec-body">
          {patents.length > 0 ? patents.map((entry: any) => {
            const p = entry.patent_id ? patentMap[entry.patent_id] : null
            const title = p ? p.title : (entry.title || '（未命名）')
            const number = p ? p.patent_number : (entry.number || '')
            const status: string = entry.status || (p?.grant_date ? '已授权' : '申请中')
            const statusClass = status === '已授权' ? 'badge-granted' : status === '实质审查' ? 'badge-exam' : 'badge-filed'
            return (
              <div class="patent-row">
                <span class="dot" />
                <span style="flex:1;color:#111827;line-height:1.55">{title}
                  {number && <span style="font-size:11px;color:var(--gray);font-family:monospace;margin-left:6px">{number}</span>}
                </span>
                <span class={`badge ${statusClass}`}>{status}</span>
              </div>
            )
          }) : <div class="empty">暂无关联专利</div>}
          </div>
        </details>

        {/* Softwares */}
        {showSoftwares && (
          <details class="section" open>
            <summary class="sec-label">软件著作权 ({softwares.length}{targetSoftwares !== null ? `/${targetSoftwares}` : ''})<span class="sec-toggle">▾</span></summary>
            <div class="sec-body">
            {softwares.length > 0 ? softwares.map((s: any) => (
              <div class="patent-row">
                <span class="dot" />
                <span style="flex:1;color:#111827;line-height:1.55">{s.name || s.title || '（未命名）'}
                  {s.number && <span style="font-size:11px;color:var(--gray);font-family:monospace;margin-left:6px">{s.number}</span>}
                </span>
                {s.status && <span class="badge badge-pub">{s.status}</span>}
              </div>
            )) : <div class="empty">暂无软件著作权</div>}
            </div>
          </details>
        )}

        {/* Standards */}
        {showStandards && (
          <details class="section" open>
            <summary class="sec-label">标准 ({standards.length}{targetStandards !== null ? `/${targetStandards}` : ''})<span class="sec-toggle">▾</span></summary>
            <div class="sec-body">
            {standards.length > 0 ? standards.map((s: any) => (
              <div class="patent-row">
                <span class="dot" />
                <span style="flex:1;color:#111827;line-height:1.55">{s.name || s.title || '（未命名）'}
                  {s.number && <span style="font-size:11px;color:var(--gray);font-family:monospace;margin-left:6px">{s.number}</span>}
                </span>
                {s.status && <span class="badge badge-pub">{s.status}</span>}
              </div>
            )) : <div class="empty">暂无标准</div>}
            </div>
          </details>
        )}

        {/* Databases */}
        {showDatabases && (
          <details class="section" open>
            <summary class="sec-label">数据库/图谱 ({databases.length}{targetDatabases !== null ? `/${targetDatabases}` : ''})<span class="sec-toggle">▾</span></summary>
            <div class="sec-body">
            {databases.length > 0 ? databases.map((d: any) => (
              <div class="patent-row">
                <span class="dot" />
                <span style="flex:1;color:#111827;line-height:1.55">{d.name || d.title || '（未命名）'}</span>
                {d.status && <span class="badge badge-pub">{d.status}</span>}
              </div>
            )) : <div class="empty">暂无数据库/图谱</div>}
            </div>
          </details>
        )}

        {/* Products */}
        {showProducts && (
          <details class="section" open>
            <summary class="sec-label">保鲜产品 ({products.length}{targetProducts !== null ? `/${targetProducts}` : ''})<span class="sec-toggle">▾</span></summary>
            <div class="sec-body">
            {products.length > 0 ? products.map((p: any) => (
              <div class="patent-row">
                <span class="dot" />
                <span style="flex:1;color:#111827;line-height:1.55">{p.name || p.title || '（未命名）'}</span>
                {p.status && <span class="badge badge-pub">{p.status}</span>}
              </div>
            )) : <div class="empty">暂无保鲜产品</div>}
            </div>
          </details>
        )}

        {/* Byproducts */}
        {showByproducts && (
          <details class="section" open>
            <summary class="sec-label">副产物原型 ({byproducts.length}{targetByproducts !== null ? `/${targetByproducts}` : ''})<span class="sec-toggle">▾</span></summary>
            <div class="sec-body">
            {byproducts.length > 0 ? byproducts.map((b: any) => (
              <div class="patent-row">
                <span class="dot" />
                <span style="flex:1;color:#111827;line-height:1.55">{b.name || b.title || '（未命名）'}</span>
                {b.status && <span class="badge badge-pub">{b.status}</span>}
              </div>
            )) : <div class="empty">暂无副产物原型</div>}
            </div>
          </details>
        )}

        {/* Major Projects */}
        {showMajorProjects && (
          <details class="section" open>
            <summary class="sec-label">重大任务 ({majorProjects.length}{targetMajorProjects !== null ? `/${targetMajorProjects}` : ''})<span class="sec-toggle">▾</span></summary>
            <div class="sec-body">
            {majorProjects.length > 0 ? majorProjects.map((m: any) => (
              <div class="patent-row">
                <span class="dot" />
                <span style="flex:1;color:#111827;line-height:1.55">{m.name || m.title || '（未命名）'}
                  {m.number && <span style="font-size:11px;color:var(--gray);font-family:monospace;margin-left:6px">{m.number}</span>}
                </span>
                {m.status && <span class="badge badge-pub">{m.status}</span>}
              </div>
            )) : <div class="empty">暂无重大任务</div>}
            </div>
          </details>
        )}

        {/* Transfers */}
        {showTransfers && (
          <details class="section" open>
            <summary class="sec-label">成果转化 ({transfers.length}{targetTransfers !== null ? `/${targetTransfers}` : ''})<span class="sec-toggle">▾</span></summary>
            <div class="sec-body">
            {transfers.length > 0 ? transfers.map((tr: any) => (
              <div class="patent-row">
                <span class="dot" />
                <span style="flex:1;color:#111827;line-height:1.55">{tr.name || tr.title || '（未命名）'}
                  {tr.partner && <span style="font-size:11px;color:var(--gray);margin-left:6px">{tr.partner}</span>}
                </span>
                {tr.status && <span class="badge badge-pub">{tr.status}</span>}
              </div>
            )) : <div class="empty">暂无成果转化</div>}
            </div>
          </details>
        )}

        {/* Students */}
        {showStudents && (
          <details class="section" open>
            <summary class="sec-label">研究生 ({students.length}{targetStudents !== null ? `/${targetStudents}` : ''})<span class="sec-toggle">▾</span></summary>
            <div class="sec-body">
            {students.length > 0 ? students.map((s: any) => (
              <div class="student-row">
                <span class="dot" />
                <span class="student-name">{s.name}</span>
                <span class="student-meta">{s.type} · {s.year}</span>
                {s.topic && <span style="color:var(--gray);font-size:12px">— {s.topic}</span>}
              </div>
            )) : <div class="empty">暂无关联研究生</div>}
            </div>
          </details>
        )}

        {/* Notes */}
        {(milestones.length > 0 || notes) && (
          <details class="section" open>
            <summary class="sec-label">备注 / 考核指标<span class="sec-toggle">▾</span></summary>
            <div class="sec-body">
            {milestones.map((m: any) => (
              <div class="milestone-row">
                <span class="mdate">{m.date}</span>
                <span>{m.text}</span>
              </div>
            ))}
            {notes && <div class="notes-text">{notes}</div>}
            </div>
          </details>
        )}
      </details>
    )
  })}
</Base>

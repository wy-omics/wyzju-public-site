---
import Base from '../../layouts/Base.astro'
import papersRaw from '../../../public-data/papers.json'
import patentsRaw from '../../../public-data/patents.json'
import trackerRaw from '../../../public-data/tracker.json'

const active = [
  { type: '国家自然科学基金面上项目', cn: '柑橘内生假单胞菌介导的陈皮关键品质形成及其SoxR–SoxS–zwf轴调控机制', number: '32672846', period: '2027.01~2030.12' },
  { type: '浙江省三农九方项目', cn: '衢橘产业高质量发展关键技术研究与应用', number: '2026SNJF079', period: '2026.01~2027.12' },
  { type: '基本科研业务费重大战略任务培育计划', cn: '植物源生鲜农产品智能保鲜物流与加工关键技术', number: '226-2026-00062', period: '2026.01~2028.12' },
  { type: '浙江省自然科学基金杭州联合基金重大项目', cn: '柑橘风味和营养物质形成的关键基因及其分子调控机制研究', number: 'LHZSD24C150001', period: '2024.01~2026.12' },
  { type: '国家自然科学基金区域联合基金', cn: '柑橘类黄酮生物合成关键基因及其网络调控机制研究', number: 'U25A20688', period: '2026.01~2029.12' },
  { type: '浙江省农业重大技术协同推广计划', cn: '柑橘采后品质维持及高值化利用技术研究与集成推广', number: '2026ZDXT02', period: '2026.01~2027.12' },
  { type: '四川省重点研发省校合作项目', cn: '川红橘现代化加工关键技术创新与高值化陈皮产品研发', number: '2026YFHZ0239', period: '2026.01~2027.12' },
  { type: '北京生命科技研究院合作项目', cn: '烟草源碱性磷酸酶分离纯化关键技术与集成工艺开发', number: '2025-KYY-135000-0004-01', period: '2026.01~2029.12' },
  { type: '北京生命科技研究院合作项目', cn: '基于能量与代谢流协同优化的烟草多模态合成底盘构建', number: '2025-KYY-135000-0004-05', period: '2026.01~2028.12' },
  { type: '横向项目', cn: '衢州柑橘果实风味和营养评价研究', number: '2025-KYY-600101-0017', period: '2026.01~2026.12' },
]

const paperMap: Record<string, any> = {}
for (const p of papersRaw as any[]) paperMap[p.id] = p

const patentMap: Record<string, any> = {}
for (const p of patentsRaw as any[]) patentMap[p.id] = p

const tracker: Record<string, any> = {}
for (const t of trackerRaw as any[]) tracker[t.project_number] = t

function authorPos(paper: any): string {
  const name = 'Wang Yue'
  const isCorr = paper.is_corresponding === true
  const isCoFirst = paper.is_co_first === true || (paper.co_first_authors && paper.co_first_authors.includes(name))
  const idx = paper.authors ? paper.authors.indexOf(name) : -1
  const isFirst = idx === 0
  if (isFirst && isCoFirst && isCorr) return '共一/通讯'
  if (isFirst && isCorr) return '第一/通讯'
  if (isCoFirst && isCorr) return '共一/通讯'
  if (isCorr) return '通讯'
  if (isCoFirst) return '共同第一'
  if (isFirst) return '第一'
  if (idx > 0) return `第${idx + 1}`
  return '参与'
}

function posColor(pos: string): string {
  if (pos.includes('通讯') || pos.includes('第一')) return '#1e40af|#dbeafe'
  return '#374151|#f3f4f6'
}

function resolveYear(dateStr: string): string {
  return dateStr ? dateStr.slice(0, 4) : ''
}
---
<Base title="项目进度" description="王岳在研项目执行进度追踪">
  <style>
    .page-header { margin-bottom: 24px }
    .page-header h1 { font-size: 26px; font-weight: 800; margin-bottom: 4px }
    .page-header p { color: var(--gray); font-size: 13px }

    /* accordion */
    details { margin-bottom: 10px; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.04) }
    details[open] { box-shadow: 0 2px 8px rgba(0,0,0,.08) }

    summary {
      list-style: none;
      cursor: pointer;
      padding: 14px 18px;
      border-bottom: 2px solid transparent;
      transition: border-color .15s;
      user-select: none;
    }
    summary::-webkit-details-marker { display: none }
    details[open] > summary { border-bottom-color: #1d4ed8 }
    summary:hover { background: #fafafa }

    .sum-top { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; flex-wrap: wrap }
    .tag-type { font-size: 11px; font-weight: 700; color: #1e40af; background: #dbeafe; padding: 2px 8px; border-radius: 4px }
    .tag-period { font-size: 11px; font-weight: 600; color: #fff; background: #059669; padding: 2px 8px; border-radius: 4px }
    .sum-counts { margin-left: auto; display: flex; gap: 6px; flex-shrink: 0 }
    .count-chip { font-size: 11px; font-weight: 600; padding: 1px 7px; border-radius: 10px; background: #f3f4f6; color: #6b7280 }
    .count-chip.has { background: #eff6ff; color: #1d4ed8 }
    .chevron { margin-left: 8px; font-size: 12px; color: #9ca3af; transition: transform .2s; flex-shrink: 0 }
    details[open] .chevron { transform: rotate(180deg) }

    .proj-title { font-size: 14px; font-weight: 700; color: #111827; line-height: 1.5 }
    .proj-num { font-size: 11px; color: var(--gray); font-family: monospace; margin-top: 2px }

    .section { padding: 12px 18px; border-top: 1px solid var(--border) }
    .sec-label { font-size: 11px; font-weight: 700; color: #9ca3af; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 8px }

    .paper-row { display: flex; flex-direction: column; gap: 2px; margin-bottom: 10px; padding-bottom: 10px; border-bottom: 1px solid #f3f4f6 }
    .paper-row:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: none }
    .paper-title-text { font-size: 13px; color: #111827; line-height: 1.55; font-weight: 500 }
    .paper-title-text a { color: #111827 }
    .paper-title-text a:hover { color: var(--blue) }
    .paper-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 5px; margin-top: 4px }
    .meta-journal { font-size: 12px; color: var(--gray); font-style: italic }
    .meta-year { font-size: 11px; color: #9ca3af }

    .badge { display: inline-block; font-size: 11px; font-weight: 600; padding: 1px 6px; border-radius: 3px; white-space: nowrap }
    .badge-if  { background: #fef3c7; color: #92400e }
    .badge-if5 { background: #fef9c3; color: #713f12 }
    .badge-pos-hi { background: #dbeafe; color: #1e40af }
    .badge-pos    { background: #f3f4f6; color: #374151 }
    .badge-pub    { background: #dcfce7; color: #166534 }
    .badge-review { background: #fef9c3; color: #92400e }
    .badge-draft  { background: #e0f2fe; color: #075985 }
    .badge-marked   { background: #d1fae5; color: #166534 }
    .badge-unmarked { background: #fef3c7; color: #92400e }
    .badge-granted  { background: #dcfce7; color: #166534 }
    .badge-exam     { background: #e0f2fe; color: #075985 }
    .badge-filed    { background: #fef9c3; color: #92400e }

    .patent-row { display: flex; align-items: flex-start; gap: 8px; margin-bottom: 8px; font-size: 13px }
    .patent-row:last-child { margin-bottom: 0 }
    .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--blue); flex-shrink: 0; margin-top: 6px }

    .student-row { display: flex; align-items: center; gap: 8px; font-size: 13px; margin-bottom: 6px }
    .student-row:last-child { margin-bottom: 0 }
    .student-name { font-weight: 600 }
    .student-meta { color: var(--gray); font-size: 12px }

    .notes-text { font-size: 13px; color: #374151; line-height: 1.7 }
    .milestone-row { display: flex; gap: 10px; font-size: 13px; margin-bottom: 5px }
    .mdate { font-size: 11px; font-family: monospace; color: var(--gray); white-space: nowrap; padding-top: 2px }
    .empty { font-size: 12px; color: #d1d5db; font-style: italic }
  </style>

  <div class="page-header">
    <h1>项目进度追踪</h1>
    <p>点击项目展开查看论文（IF / IF5 / 标注位次）· 专利 · 研究生</p>
  </div>

  {active.map(proj => {
    const t = tracker[proj.number] || {}
    const papers: any[] = t.papers || []
    const patents: any[] = t.patents || []
    const students: any[] = t.students || []
    const milestones: any[] = t.milestones || []
    const notes: string = t.notes || ''

    return (
      <details>
        <summary>
          <div class="sum-top">
            <span class="tag-type">{proj.type}</span>
            <span class="tag-period">{proj.period}</span>
            <div class="sum-counts">
              <span class={`count-chip${papers.length ? ' has' : ''}`}>论文 {papers.length}</span>
              <span class={`count-chip${patents.length ? ' has' : ''}`}>专利 {patents.length}</span>
              <span class={`count-chip${students.length ? ' has' : ''}`}>研究生 {students.length}</span>
              <span class="chevron">▼</span>
            </div>
          </div>
          <div class="proj-title">{proj.cn}</div>
          <div class="proj-num">{proj.number}</div>
        </summary>

        {/* Papers */}
        <div class="section">
          <div class="sec-label">论文 ({papers.length})</div>
          {papers.length > 0 ? papers.map((entry: any) => {
            const p = entry.paper_id ? paperMap[entry.paper_id] : null
            const title = p ? p.title : (entry.title || '（未命名）')
            const doi = p ? p.doi : entry.doi
            const journal = p ? p.journal : (entry.journal || '')
            const year = p ? resolveYear(p.date) : (entry.year || '')
            const jif = p ? p.jif : entry.jif
            const if5val = p ? p.if5 : entry.if5
            const pos = p ? authorPos(p) : ''
            const posIsKey = pos.includes('通讯') || pos.includes('第一')
            const status: string = entry.status || (p ? '已发表' : '')
            const statusClass = status === '已发表' ? 'badge-pub' : status === '在审' ? 'badge-review' : 'badge-draft'
            const fundMarked: boolean | undefined = entry.fund_marked
            return (
              <div class="paper-row">
                <div class="paper-title-text" set:html={doi
                  ? `<a href="https://doi.org/${doi}" target="_blank" rel="noopener">${title}</a>`
                  : title} />
                <div class="paper-meta">
                  {journal && <span class="meta-journal">{journal}</span>}
                  {year && <span class="meta-year">{year}</span>}
                  {jif != null && <span class="badge badge-if">IF {jif}</span>}
                  {if5val != null && <span class="badge badge-if5">IF5 {if5val}</span>}
                  {pos && <span class={`badge ${posIsKey ? 'badge-pos-hi' : 'badge-pos'}`}>{pos}</span>}
                  {status && <span class={`badge ${statusClass}`}>{status}</span>}
                  {fundMarked !== undefined && (
                    <span class={`badge ${fundMarked ? 'badge-marked' : 'badge-unmarked'}`}>
                      {fundMarked ? '已标注' : '待标注'}
                    </span>
                  )}
                </div>
              </div>
            )
          }) : <div class="empty">暂无关联论文</div>}
        </div>

        {/* Patents */}
        <div class="section">
          <div class="sec-label">专利 ({patents.length})</div>
          {patents.length > 0 ? patents.map((entry: any) => {
            const p = entry.patent_id ? patentMap[entry.patent_id] : null
            const title = p ? p.title : (entry.title || '（未命名）')
            const number = p ? p.patent_number : (entry.number || '')
            const status: string = entry.status || (p?.grant_date ? '已授权' : '申请中')
            const statusClass = status === '已授权' ? 'badge-granted' : status === '实质审查' ? 'badge-exam' : 'badge-filed'
            return (
              <div class="patent-row">
                <span class="dot" />
                <span style="flex:1;color:#111827;line-height:1.55">{title}
                  {number && <span style="font-size:11px;color:var(--gray);font-family:monospace;margin-left:6px">{number}</span>}
                </span>
                <span class={`badge ${statusClass}`}>{status}</span>
              </div>
            )
          }) : <div class="empty">暂无关联专利</div>}
        </div>

        {/* Students */}
        <div class="section">
          <div class="sec-label">研究生 ({students.length})</div>
          {students.length > 0 ? students.map((s: any) => (
            <div class="student-row">
              <span class="dot" />
              <span class="student-name">{s.name}</span>
              <span class="student-meta">{s.type} · {s.year}</span>
              {s.topic && <span style="color:var(--gray);font-size:12px">— {s.topic}</span>}
            </div>
          )) : <div class="empty">暂无关联研究生</div>}
        </div>

        {/* Notes */}
        {(milestones.length > 0 || notes) && (
          <div class="section">
            <div class="sec-label">备注 / 考核指标</div>
            {milestones.map((m: any) => (
              <div class="milestone-row">
                <span class="mdate">{m.date}</span>
                <span>{m.text}</span>
              </div>
            ))}
            {notes && <div class="notes-text">{notes}</div>}
          </div>
        )}
      </details>
    )
  })}
</Base>

---
import Base from '../layouts/Base.astro'
import papers from '../../public-data/papers.json'
import patents from '../../public-data/patents.json'
import software from '../../public-data/software.json'
import standards from '../../public-data/standards.json'

const isFirstCorr = (p: any) =>
  ['first_author','first_or_corresponding','corresponding'].includes(p.author_role)

const firstCorrPapers = [...papers].filter(isFirstCorr).sort((a:any,b:any) => b.date?.localeCompare(a.date))
const coAuthorPapers  = [...papers].filter((p:any) => !isFirstCorr(p)).sort((a:any,b:any) => b.date?.localeCompare(a.date))
const highIfCount = firstCorrPapers.filter((p:any) => p.jif != null && p.jif >= 10).length
const fmtIf = (v: number) => Number.isInteger(v) ? v.toFixed(1) : String(v)
const firstPatents = (patents as any[]).filter(p => p.inventors?.[0]==='王岳'||p.inventors?.[0]==='Wang Yue')
const coPatents    = (patents as any[]).filter(p => p.inventors?.[0]!=='王岳'&&p.inventors?.[0]!=='Wang Yue')

function fmtName(name: string, corrSet?: Set<string>, cofirstSet?: Set<string>): string {
  const hash = (cofirstSet instanceof Set && cofirstSet.has(name)) ? '<sup>#</sup>' : ''
  const star = (corrSet instanceof Set && corrSet.has(name)) ? '<sup>*</sup>' : ''
  if (name==='王岳') return `<strong>王岳</strong>${hash}${star}`
  if (name==='Wang Yue') return `<strong>Yue Wang</strong>${hash}${star}`
  const parts = name.trim().split(' ')
  const display = parts.length===2 ? `${parts[1]} ${parts[0]}` : name
  return display + hash + star
}
function authorHtml(authors: string[], corr: string[] = [], cofirst: string[] = []): string {
  const corrSet = new Set(corr)
  const cofirstSet = new Set(cofirst)
  return authors.map(n => fmtName(n, corrSet, cofirstSet)).join(', ')
}
function wyRoleEn(p: any): string {
  const authors: string[] = p.authors || []
  const corr: string[] = p.corresponding_authors || []
  const cofirst: string[] = p.co_first_authors || []
  const wy = authors.includes('Wang Yue') ? 'Wang Yue' : '王岳'
  const idx = authors.indexOf(wy)
  if (idx < 0) return ''
  const isWyCofirst = cofirst.includes(wy)
  const isWyFirst = idx === 0
  const isWyCorr = corr.includes(wy)
  const isLast = idx === authors.length - 1
  const parts: string[] = []
  if (isWyCofirst) parts.push('Co-first')
  else if (isWyFirst) parts.push('First')
  if (isWyCorr) {
    if (corr.length === 1) parts.push('Corresp.')
    else if (isLast) parts.push('Last corresp.')
    else parts.push('Co-corresp.')
  }
  return parts.join(' / ')
}

function groupByYear(list: any[]): { yr: string; pubs: any[] }[] {
  const byYear: Record<string, any[]> = {}
  for (const p of list) {
    const yr = p.date?.slice(0,4) ?? 'n.d.'
    if (!byYear[yr]) byYear[yr] = []
    byYear[yr].push(p)
  }
  return Object.keys(byYear).sort((a,b) => b.localeCompare(a)).map(yr => ({ yr, pubs: byYear[yr] }))
}

let fcIdx = firstCorrPapers.length
const fcGroupsNum = groupByYear(firstCorrPapers).map(({ yr, pubs }) => ({
  yr,
  pubs: pubs.map(p => {
    const role = wyRoleEn(p)
    return { ...p, num: fcIdx--, role }
  })
}))

let coIdx = coAuthorPapers.length
const coGroupsNum = groupByYear(coAuthorPapers).map(({ yr, pubs }) => ({
  yr,
  pubs: pubs.map(p => ({ ...p, num: coIdx-- }))
}))
---
<Base title="CV (EN)" description="Wang Yue, Associate Researcher, Zhejiang University">
<style>
  .cv-wrap { max-width: 860px; margin: 0 auto }
  .print-btn {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--blue); color: #fff; border: none; border-radius: 6px;
    padding: 8px 18px; font-size: 13px; font-weight: 600; cursor: pointer;
    margin-bottom: 24px;
  }
  .print-btn:hover { background: #1e40af }

  .cv-header { display: flex; gap: 24px; align-items: flex-start; margin-bottom: 28px; padding-bottom: 20px; border-bottom: 2px solid #111827 }
  .cv-header img { width: 120px; height: 120px; object-fit: cover; border-radius: 8px; border: 1px solid var(--border); flex-shrink: 0 }
  .cv-name { font-size: 28px; font-weight: 800; letter-spacing: .04em; margin-bottom: 4px }
  .cv-title { font-size: 14px; color: #374151; line-height: 1.7; margin-bottom: 6px }
  .cv-contact { font-size: 13px; color: #4b5563; line-height: 1.8 }
  .cv-contact a { color: #4b5563 }

  .s-title {
    font-size: 14px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em;
    color: #111827; border-bottom: 2px solid #111827;
    padding-bottom: 4px; margin: 28px 0 12px;
  }
  .item { margin-bottom: 8px; font-size: 13.5px; line-height: 1.65; color: #1f2937 }
  .rd-grid { display: flex; flex-direction: column; gap: 10px; margin-bottom: 4px }
  .rd-item { font-size: 13px; line-height: 1.6; color: #1f2937 }
  .rd-item h3 { font-size: 13px; font-weight: 700; color: #1d4ed8; margin-bottom: 3px }
  .item .year { display: inline-block; min-width: 140px; color: #6b7280; font-size: 12.5px; vertical-align: top }
  .item .body { display: inline-block; width: calc(100% - 150px); vertical-align: top }

  .pub { font-size: 13px; line-height: 1.7; margin-bottom: 10px; padding-left: 28px; position: relative; color: #1f2937 }
  .pub .num { position: absolute; left: 0; color: #6b7280; font-size: 12px; top: 1px }
  .pub .ptitle { font-weight: 600 }
  .pub .ptitle a { color: #111827 }
  .pub .ptitle a:hover { color: var(--blue) }
  .pub .pmeta { color: #4b5563 }
  .jname { font-style: italic }
  .badge-hc  { display: inline-block; background: #fef3c7; color: #92400e; font-size: 10px; font-weight: 700; padding: 1px 5px; border-radius: 3px; margin-left: 5px; vertical-align: middle }
  .badge-pdf { display: inline-block; background: #d1fae5; color: #065f46; font-size: 10px; font-weight: 700; padding: 1px 5px; border-radius: 3px; margin-left: 5px; vertical-align: middle; text-decoration: none }
  .role-badge { display: inline-block; padding: 1px 5px; border-radius: 3px; font-size: 10px; font-weight: 700; margin-left: 5px; vertical-align: middle }
  .rb-corr     { background: #1e40af; color: #fff }
  .rb-lastcorr { background: #1e40af; color: #fff }
  .rb-cocorr   { background: #1e40af; color: #fff }
  .rb-first    { background: #bfdbfe; color: #1e3a8a }
  .rb-cofirst  { background: #bfdbfe; color: #1e3a8a }
  .if-badge  { display: inline-block; padding: 1px 5px; border-radius: 3px; font-size: 10px; font-weight: 700; margin-left: 5px; vertical-align: middle }
  .if5-badge { display: inline-block; padding: 1px 5px; border-radius: 3px; font-size: 10px; font-weight: 700; margin-left: 3px; vertical-align: middle }
  .if-high  { background: #fee2e2; color: #991b1b }
  .if-mid   { background: #dbeafe; color: #1e40af }
  .if5-high { background: #fce7f3; color: #9d174d }
  .if5-mid  { background: #e0e7ff; color: #4338ca }

  .yr-sep { font-size: 12px; font-weight: 700; color: #6b7280; margin: 14px 0 6px; border-bottom: 1px solid var(--border); padding-bottom: 2px }

  .grant { margin-bottom: 9px; font-size: 13px; line-height: 1.6 }
  .grant .g-name { font-weight: 600; color: #111827 }
  .grant .g-meta { color: #4b5563; font-size: 12px }
  .g-badge { display: inline-block; background: #dbeafe; color: #1e40af; font-size: 11px; font-weight: 600; padding: 1px 7px; border-radius: 4px; margin-left: 6px }
  .g-badge-sub { background: #f0fdf4; color: #166534 }

  .rev-wrap { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px }
  .rev-tag { background: #f3f4f6; border: 1px solid var(--border); border-radius: 4px; padding: 2px 8px; font-size: 11.5px }

  @media print {
    @page { size: A4; margin: 18mm 18mm 20mm }
    body { background: #fff !important }
    header, footer, .print-btn { display: none !important }
    main { padding: 0 !important; max-width: 100% !important }
    .cv-wrap { max-width: 100% }
    .pub, .item, .grant { page-break-inside: avoid }
    .s-title { page-break-after: avoid }
    a { color: #111827 !important; text-decoration: none }
    .badge-hc, .badge-pdf { display: none }
  }
</style>

<div class="cv-wrap">

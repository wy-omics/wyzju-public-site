              {p.issue && `(${p.issue})`}
              {p.pages && `, ${p.pages}`}
              {p.date && ` (${p.date.slice(0,4)})`}
              {p.jif != null && <span class={`if-badge ${p.jif >= 10 ? 'if-high' : 'if-mid'}`}>IF {fmtIf(p.jif)}</span>}

    .info-section li .year { color: #4b5563; font-size: 13px; margin-right: 8px }
    .acad-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 40px }
    .acad-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 10px 15px; font-size: 14px; line-height: 1.5; color: #374151; display: flex; justify-content: space-between; align-items: baseline; gap: 16px }
    .acad-card strong { color: #111827 }
    .acad-card .acad-time { font-size: 12px; color: var(--gray); white-space: nowrap; flex-shrink: 0 }
    .reviewer-wrap { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px }
    .rev-tag { background: #fff; border: 1px solid var(--border); border-radius: 4px; padding: 2px 9px; font-size: 12px; color: #374151 }
    .section-title { font-size: 17px; font-weight: 700; margin: 36px 0 14px; padding-bottom: 8px; border-bottom: 2px solid var(--border) }
    .year-section { margin-bottom: 24px }
    .year-label { font-size: 13px; font-weight: 600; color: var(--gray); margin-bottom: 8px; padding-bottom: 4px; border-bottom: 1px solid var(--border) }
    .paper-list { display: flex; flex-direction: column; gap: 8px }
    .paper-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 12px 16px; display: flex; gap: 12px; align-items: flex-start }
    .paper-num { color: var(--gray); font-size: 12px; min-width: 28px; padding-top: 2px; text-align: right; flex-shrink: 0 }
    .paper-body { flex: 1 }
    .paper-title { font-size: 14px; font-weight: 600; margin-bottom: 4px; line-height: 1.5 }
    .paper-meta { font-size: 12px; color: var(--gray); line-height: 1.6 }
    .journal { color: var(--blue); font-weight: 500 }
    .badge { display: inline-block; padding: 1px 7px; border-radius: 99px; font-size: 11px; font-weight: 600; vertical-align: middle; margin-left: 6px }
    .badge-green { background: #d1fae5; color: #065f46 }
    .badge-yellow { background: #fef3c7; color: #92400e }
    .if5-badge { display: inline-block; padding: 1px 7px; border-radius: 4px; font-size: 11px; font-weight: 700; background: #dbeafe; color: #1e40af; margin-left: 6px; vertical-align: middle }
    .book-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 13px 16px; font-size: 14px; line-height: 1.7; color: #374151; margin-bottom: 8px }

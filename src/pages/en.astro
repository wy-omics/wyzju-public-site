                    <Fragment set:html={authorListHtml(p.authors)} />
                    <br />
                    <span class="journal">{p.journal}</span>
                    {p.volume && `, ${p.volume}`}
                    {p.issue && `(${p.issue})`}
                    {p.pages && `, ${p.pages}`}

            )
          })}
        </div>
      </div>
    ))
  })()}

  <!-- Publications: Co-Author -->
  <div class="section-title">Publications — Co-Author ({coAuthorPapers.length} papers)</div>
  {(() => {
    const groups = groupByYear(coAuthorPapers)
    let idx = coAuthorPapers.length
    return groups.map(({ yr, papers: ps }) => (

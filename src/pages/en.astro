    <span class="g-meta">Zhejiang Provincial Universities Fundamental Research Funds (226-2024-00211) · Jan 2024–Dec 2025</span>
  </div>

  <div class="s-title">Publications — First or Corresponding Author ({firstCorrPapers.length})</div>
  {fcGroupsNum.map(({ yr, pubs }) => (
    <div>
      <div class="yr-sep">{yr}</div>
      {pubs.map((p: any) => {
        const cls = p.role?.includes('Last') ? 'rb-lastcorr' : p.role?.includes('Co-corresp') ? 'rb-cocorr' : p.role?.includes('Corresp') ? 'rb-corr' : p.role?.includes('Co-first') ? 'rb-cofirst' : 'rb-first'
        return (
          <div class="pub">
            <span class="num">{p.num}.</span>

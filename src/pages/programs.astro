---
<Base title="科研项目" description="王岳主持的科研项目">
  <style>
    .page-header { margin-bottom: 32px }
    .page-header h1 { font-size: 26px; font-weight: 800; margin-bottom: 6px }
    h2 { font-size: 18px; font-weight: 700; margin: 32px 0 14px; padding-bottom: 8px; border-bottom: 2px solid var(--border) }
    .proj-list { display: flex; flex-direction: column; gap: 10px }
    .proj-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 14px 16px }
    .proj-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; gap: 12px }
    .proj-type { font-size: 13px; font-weight: 700; color: #1e40af; background: #dbeafe; padding: 3px 10px; border-radius: 4px; white-space: nowrap }
    .proj-period { font-size: 12px; font-weight: 600; color: #fff; background: #059669; padding: 2px 9px; border-radius: 4px; white-space: nowrap }
    .proj-cn { font-size: 14px; font-weight: 600; color: #111827; margin-bottom: 3px; line-height: 1.5 }
    .proj-en { font-size: 12px; color: var(--gray); line-height: 1.5; margin-bottom: 6px }
    .proj-footer { display: flex; gap: 12px; font-size: 12px; color: var(--gray) }
    .proj-number { font-family: monospace }
    .role-badge { font-size: 11px; font-weight: 600; padding: 1px 7px; border-radius: 4px; background: #f0fdf4; color: #166534 }
    .role-badge.coauth { background: #f9fafb; color: #6b7280 }
    .proj-type-fin { color: #6b7280; background: #f3f4f6 }
    .proj-period-fin { background: #9ca3af }
  </style>

  <div class="page-header">
    <h1>科研项目</h1>
  </div>

  <h2>在研项目</h2>
  <div class="proj-list">
    {active.map(p => (
      <div class="proj-card">
        <div class="proj-header">
          <span class="proj-type">{p.type}</span>
          <span class="proj-period">{p.period}</span>
        </div>
        <div class="proj-cn">{p.cn}（{p.number}）</div>
        <div class="proj-en">{p.en} (Grant No. {p.number})</div>
        <div class="proj-footer">
          <span class={`role-badge${p.role === '参与' ? ' coauth' : ''}`}>{p.role}</span>
        </div>
      </div>
    ))}
  </div>

  <h2>已结题项目</h2>
  <div class="proj-list">
    {finished.map(p => (
      <div class="proj-card">
        <div class="proj-header">
          <span class={`proj-type proj-type-fin`}>{p.type}</span>
          <span class={`proj-period proj-period-fin`}>{p.period}</span>
        </div>
        <div class="proj-cn">{p.cn}（{p.number}）</div>
        <div class="proj-en">{p.en} (Grant No. {p.number})</div>
        <div class="proj-footer">
          <span class={`role-badge${p.role === '参与' ? ' coauth' : ''}`}>{p.role}</span>
        </div>
      </div>
    ))}
  </div>
</Base>

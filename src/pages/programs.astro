---
import Base from '../layouts/Base.astro'
---
<Base title="科研项目" description="王岳主持的科研项目">
  <style>
    .page-header { margin-bottom: 32px }
    .page-header h1 { font-size: 26px; font-weight: 800; margin-bottom: 6px }
    h2 { font-size: 18px; font-weight: 700; margin: 32px 0 14px; padding-bottom: 8px; border-bottom: 2px solid var(--border) }
    .proj-list { display: flex; flex-direction: column; gap: 12px }
    .proj-card {
      background: #fff; border: 1px solid var(--border); border-radius: 8px;
      padding: 14px 16px;
    }
    .proj-title { font-size: 14px; font-weight: 600; margin-bottom: 6px; line-height: 1.5 }
    .proj-meta { font-size: 12px; color: var(--gray); line-height: 1.7 }
    .badge {
      display: inline-block; padding: 1px 8px; border-radius: 4px;
      font-size: 11px; font-weight: 600; margin-right: 6px;
    }
    .badge-blue { background: #dbeafe; color: #1e40af }
    .badge-gray { background: #f3f4f6; color: #374151 }
  </style>

  <div class="page-header">
    <h1>科研项目</h1>
  </div>

  <h2>在研项目</h2>
  <div class="proj-list">

    <div class="proj-card">
      <div class="proj-title">衢橘产业高质量发展关键技术研究与应用（2026SNJF079）</div>
      <div class="proj-meta">
        <span class="badge badge-blue">主持</span>
        浙江省三农九方项目 · 2026.01 – 2027.12
      </div>
    </div>

    <div class="proj-card">
      <div class="proj-title">柑橘风味和营养物质形成的关键基因及其分子调控机制研究（LHZSD24C150001）</div>
      <div class="proj-meta">
        <span class="badge badge-blue">课题负责人</span>
        浙江省自然科学基金杭州联合基金重大项目 · 2024.01 – 2026.12
      </div>
    </div>

    <div class="proj-card">
      <div class="proj-title">柑橘类黄酮生物合成关键基因及其网络调控机制研究（U25A20688）</div>
      <div class="proj-meta">
        <span class="badge badge-blue">课题负责人</span>
        国家自然科学基金区域联合基金 · 2026.01 – 2029.12
      </div>
    </div>

    <div class="proj-card">
      <div class="proj-title">柑橘采后品质维持及高值化利用技术研究与集成推广（2026ZDXT02）</div>
      <div class="proj-meta">
        <span class="badge badge-blue">课题负责人</span>
        浙江省农业重大技术协同推广计划 · 2026.01 – 2027.12
      </div>
    </div>

    <div class="proj-card">
      <div class="proj-title">川红橘现代化加工关键技术创新与高值化陈皮产品研发（2026YFHZ0239）</div>
      <div class="proj-meta">
        <span class="badge badge-blue">课题负责人</span>
        四川省重点研发省校合作项目 · 2026.01 – 2027.12
      </div>
    </div>

    <div class="proj-card">
      <div class="proj-title">烟草源碱性磷酸酶分离纯化关键技术与集成工艺开发（2025-KYY-135000-0004-01）</div>
      <div class="proj-meta">
        <span class="badge badge-blue">课题负责人</span>
        北京生命科技研究院合作项目 · 2026.01 – 2029.12
      </div>
    </div>

    <div class="proj-card">
      <div class="proj-title">基于能量与代谢流协同优化的烟草多模态合成底盘构建（2025-KYY-135000-0004-05）</div>
      <div class="proj-meta">
        <span class="badge badge-blue">课题负责人</span>
        北京生命科技研究院合作项目 · 2026.01 – 2028.12
      </div>
    </div>

    <div class="proj-card">
      <div class="proj-title">衢州柑橘果实风味和营养评价研究（2025-KYY-600101-0017）</div>
      <div class="proj-meta">
        <span class="badge badge-blue">主持</span>
        横向项目 · 2026.01 – 2026.12
      </div>
    </div>

  </div>

  <h2>已结题项目</h2>
  <div class="proj-list">

    <div class="proj-card">
      <div class="proj-title">基于Nrf2泛素化抑制的果实类黄酮抗氧化机制研究（32101932）</div>
      <div class="proj-meta">
        <span class="badge badge-gray">已结题</span>
        国家自然科学基金青年项目 · 2022.01 – 2024.12 · 主持
      </div>
    </div>

    <div class="proj-card">
      <div class="proj-title">药食同源功能健康食品研发——浙江省特色药食同源功能健康食品开发（2021C02018）</div>
      <div class="proj-meta">
        <span class="badge badge-gray">已结题</span>
        浙江省重点研发计划课题 · 2021.01 – 2023.12 · 主持
      </div>
    </div>

    <div class="proj-card">
      <div class="proj-title">柑橘黄酮对细胞内源性ROS的双向调控机制研究（2021M692833）</div>
      <div class="proj-meta">
        <span class="badge badge-gray">已结题</span>
        中国博士后科学基金面上资助 · 2021.06 – 2023.06 · 主持
      </div>
    </div>

    <div class="proj-card">
      <div class="proj-title">衢州柑橘果实品质评价研究（2024-KYY-600101-0022）</div>
      <div class="proj-meta">
        <span class="badge badge-gray">已结题</span>
        横向项目 · 2024.12 – 2025.12 · 主持
      </div>
    </div>

    <div class="proj-card">
      <div class="proj-title">衢州特色柑橘果实品质检测（2023-KYY-516103-0008）</div>
      <div class="proj-meta">
        <span class="badge badge-gray">已结题</span>
        横向项目 · 2023.12 – 2024.12 · 主持
      </div>
    </div>

    <div class="proj-card">
      <div class="proj-title">水果风味表型组学研究（226-2024-00211）</div>
      <div class="proj-meta">
        <span class="badge badge-gray">已结题</span>
        浙江省高校基本科研业务费 · 2024.01 – 2025.12 · 主持
      </div>
    </div>

    <div class="proj-card">
      <div class="proj-title">柑橘果实PMFs抗氧化应激作用机理研究（32072132）</div>
      <div class="proj-meta">
        <span class="badge badge-gray">已结题</span>
        国家自然科学基金面上项目 · 2021.01 – 2024.12 · 参与
      </div>
    </div>

    <div class="proj-card">
      <div class="proj-title">食品营养及生物活性物质的健康功能作用研究（2017YFD0400200）</div>
      <div class="proj-meta">
        <span class="badge badge-gray">已结题</span>
        国家重点研发计划 · 2017.01 – 2020.12 · 参与
      </div>
    </div>

  </div>
</Base>

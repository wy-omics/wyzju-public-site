---
import Base from '../layouts/Base.astro'
import stats from '../../public-data/stats.json'
---
<Base title="主页">
  <style>
    .hero { margin-bottom: 48px }
    .hero-top { display: flex; gap: 28px; align-items: flex-start; margin-bottom: 20px }
    .hero-info { display: flex; flex-direction: column; justify-content: space-between; height: 160px }
    .hero-info h1 { font-size: 34px; font-weight: 800; margin-bottom: 4px; letter-spacing: 0.12em }
    .hero-info .affil { color: #374151; font-size: 14px; margin-bottom: 0; line-height: 1.6 }
    .hero-info .contact { font-size: 13px; color: #4b5563 }
    .hero-info .contact a { color: #4b5563 }
    .hero-bio { font-size: 16px; color: #374151; line-height: 1.8; margin-bottom: 40px }
    h2 { font-size: 18px; font-weight: 700; margin: 36px 0 14px; padding-bottom: 8px; border-bottom: 2px solid var(--border) }
    .info-section { margin-bottom: 40px }
    .info-section ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 8px }
    .info-section li { font-size: 15px; color: #374151; background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 10px 14px }
    .info-section li .year { color: #4b5563; font-size: 13px; margin-right: 8px }
    .acad-list { display: flex; flex-direction: column; gap: 8px }
    .acad-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 10px 15px; font-size: 14px; line-height: 1.5; color: #374151; display: flex; justify-content: space-between; align-items: baseline; gap: 16px }
    .acad-card strong { color: #111827 }
    .acad-card .acad-time { font-size: 12px; color: var(--gray); white-space: nowrap; flex-shrink: 0 }
    .reviewer-wrap { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px }
    .rev-tag { background: #fff; border: 1px solid var(--border); border-radius: 4px; padding: 2px 9px; font-size: 12px; color: #374151 }
    .talk-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 11px 15px; font-size: 13px; line-height: 1.6; color: #374151 }
  </style>

  <div class="hero">
    <div class="hero-top">
      <div>
        <img src="/photo.png" alt="王岳" style="width:160px;height:160px;object-fit:cover;border-radius:10px;border:1px solid var(--border)" />
      </div>
      <div class="hero-info">
        <h1>王岳</h1>
        <div class="affil">
          副研究员 · 浙江大学<br />
          特种作物数智化技术研究中心副主任
        </div>
        <div class="contact">
          📧 <a href="mailto:fruit@zju.edu.cn">fruit@zju.edu.cn</a><br />
          浙江省杭州市西湖区浙江大学紫金港校区农生环A座
        </div>
      </div>
    </div>
    <p class="hero-bio">
      研究方向为果实营养与风味品质，重点解析柑橘等果实品质活性物质的生物合成调控、品质演化与内生菌驱动机制及其健康功效，同时开展面向农业科研的 AI 基础数据库构建与智能体开发。
      主持国家自然科学基金面上项目、区域联合重点项目课题、浙江省三农九方项目、浙江省农业重大协同推广项目课题、浙江省重点研发计划课题等项目。
      以主要完成人获得教育部科技进步一等奖1项。
      相关研究成果在 Molecular Plant 等杂志发表论文70余篇，被引2200+，高被引论文2篇，H-index 27，i10-index 40。
    </p>
  </div>

  <div class="info-section">
    <h2>工作经历</h2>
    <ul>
      <li><span class="year">2024.03 - 至今</span>浙江大学 新农村发展研究院 交叉研究平台</li>
      <li><span class="year">2023.01 - 至今</span>浙江大学 果树所 副研究员</li>
      <li><span class="year">2020.07 - 2024.02</span>浙江大学 果树所 博士后；合作导师：孙崇德 教授</li>
    </ul>
  </div>

  <div class="info-section">
    <h2>教育经历</h2>
    <ul>
      <li><span class="year">2015.09 - 2020.06</span>浙江大学 果树学 博士；导师：孙崇德 教授</li>
      <li><span class="year">2011.09 - 2015.06</span>浙江大学 园艺学 学士</li>
    </ul>
  </div>

  <h2>学术兼职</h2>
  <div class="acad-list">
    <div class="acad-card"><span><strong>eFood</strong> 副主编（Associate Editor）</span><span class="acad-time">2024.10 - 至今</span></div>
    <div class="acad-card"><span><strong>Frontiers in Nutrition</strong> 副主编（Associate Editor）</span><span class="acad-time">2024.10 - 至今</span></div>
    <div class="acad-card"><span><strong>Food Chemistry International</strong> 编辑部主任（Deputy Editor）</span><span class="acad-time">2024.12 - 至今</span></div>
    <div class="acad-card"><span><strong>Food Frontiers</strong> 编委（Editorial Board Member）</span><span class="acad-time">2025.08 - 至今</span></div>
    <div class="acad-card"><span><strong>Letters in Functional Foods</strong> 编委（Editorial Board Member）</span><span class="acad-time">2024.12 - 至今</span></div>
    <div class="acad-card"><span><strong>iMeta</strong> 青年编委</span><span class="acad-time">2025.04 - 至今</span></div>
    <div class="acad-card"><span><strong>Phyton-International Journal of Experimental Botany</strong> 青年编委（Early Career Editorial Board Member）</span><span class="acad-time">2023.04 - 至今</span></div>
    <div class="acad-card"><span><strong>Antioxidants</strong> 专题咨询小组成员（Topical Advisory Panel Member）</span><span class="acad-time">2022.06 - 至今</span></div>
    <div class="acad-card"><span><strong>Frontiers in Nutrition</strong> 编委会审稿编辑（Review Editor on the Editorial Board）</span><span class="acad-time">2022.07 - 至今</span></div>
    <div class="acad-card"><span><strong>Journal of Integrative Agriculture（农业科学学报）</strong> 学术联络员</span><span class="acad-time">2023.06 - 至今</span></div>
    <div class="acad-card" style="flex-direction:column;align-items:flex-start;gap:4px">
      <div style="font-weight:600;color:#111827;margin-bottom:2px">客座主编（Guest Editor）— <strong>Antioxidants</strong>（3期SI）</div>
      <div style="color:#4b5563;font-size:13px;line-height:1.7;padding-left:2px">
        · The Preventive and Therapeutic Effects of Fruit Antioxidants on Chronic Diseases<br/>
        · Antioxidants in Fruits and Their Health-Promoting Effects<br/>
        · <a href="https://www.mdpi.com/journal/antioxidants/special_issues/9F28CX25D8" target="_blank" rel="noopener">Natural Antioxidants from Plants in Combating Metabolism-Related Diseases</a>
      </div>
    </div>
    <div class="acad-card" style="flex-direction:column;align-items:flex-start;gap:4px">
      <div style="font-weight:600;color:#111827;margin-bottom:2px">客座主编（Guest Editor）— <strong>Frontiers in Nutrition</strong> &amp; <strong>Frontiers in Immunology</strong>（联合SI）</div>
      <div style="color:#4b5563;font-size:13px;padding-left:2px">
        · Effects of Plant-Derived Bioactive Compounds as Nutritional Supplements on Inflammation
      </div>
    </div>
    <div class="acad-card" style="flex-direction:column;align-items:flex-start;gap:6px">
      <div style="font-weight:600;color:#111827;margin-bottom:2px">受邀审稿（Reviewer）</div>
      <div class="reviewer-wrap">
        <span class="rev-tag">Trends in Food Science &amp; Technology</span>
        <span class="rev-tag">Nature Communications</span>
        <span class="rev-tag">Journal of Advanced Research</span>
        <span class="rev-tag">Critical Reviews in Food Science and Nutrition</span>
        <span class="rev-tag">Food Frontiers</span>
        <span class="rev-tag">Food Hydrocolloids</span>
        <span class="rev-tag">Food Chemistry</span>
        <span class="rev-tag">Pharmacological Research</span>
        <span class="rev-tag">Phytomedicine</span>
        <span class="rev-tag">Food and Chemical Toxicology</span>
        <span class="rev-tag">Plant Communications</span>
        <span class="rev-tag">Current Opinion in Plant Biology</span>
        <span class="rev-tag">Food Control</span>
        <span class="rev-tag">Postharvest Biology and Technology</span>
        <span class="rev-tag">LWT - Food Science &amp; Technology</span>
        <span class="rev-tag">Journal of Environmental Sciences</span>
      </div>
    </div>
    <div class="acad-card" style="align-items:center">
      <span>受邀报告：第二届农业食品青年科学家学术沙龙 大会报告 · 2024.11.8~10 · 山东 济南</span>
      <span style="font-size:12px;font-weight:600;background:#fef3c7;color:#92400e;padding:2px 8px;border-radius:4px;white-space:nowrap;flex-shrink:0">最佳汇报奖</span>
    </div>
  </div>
</Base>

<Base title="简历" description="王岳学术简历">
<style>
  .cv-wrap { max-width: 860px; margin: 0 auto }
  .print-btn {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--blue); color: #fff; border: none; border-radius: 6px;
    padding: 8px 18px; font-size: 13px; font-weight: 600; cursor: pointer;
    margin-bottom: 24px;
  }
  .print-btn:hover { background: #1e40af }

  .cv-header { display: flex; gap: 24px; align-items: flex-start; margin-bottom: 28px; padding-bottom: 20px; border-bottom: 2px solid #111827 }
  .cv-header img { width: 120px; height: 120px; object-fit: cover; border-radius: 8px; border: 1px solid var(--border); flex-shrink: 0 }
  .cv-name { font-size: 28px; font-weight: 800; letter-spacing: .08em; margin-bottom: 4px }
  .cv-title { font-size: 14px; color: #374151; line-height: 1.7; margin-bottom: 6px }
  .cv-contact { font-size: 13px; color: #4b5563; line-height: 1.8 }
  .cv-contact a { color: #4b5563 }

  .s-title {
    font-size: 14px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em;
    color: #111827; border-bottom: 2px solid #111827;
    padding-bottom: 4px; margin: 28px 0 12px;
  }
  .item { margin-bottom: 8px; font-size: 13.5px; line-height: 1.65; color: #1f2937 }
  .item .year { display: inline-block; min-width: 130px; color: #6b7280; font-size: 12.5px; vertical-align: top }
  .item .body { display: inline-block; width: calc(100% - 140px); vertical-align: top }

  .pub { font-size: 13px; line-height: 1.7; margin-bottom: 10px; padding-left: 28px; position: relative; color: #1f2937 }
  .pub .num { position: absolute; left: 0; color: #6b7280; font-size: 12px; top: 1px }
  .pub .ptitle { font-weight: 600 }
  .pub .ptitle a { color: #111827 }
  .pub .ptitle a:hover { color: var(--blue) }
  .pub .pmeta { color: #4b5563 }
  .jname { font-style: italic }
  .badge-hc { display: inline-block; background: #fef3c7; color: #92400e; font-size: 10px; font-weight: 700; padding: 1px 5px; border-radius: 3px; margin-left: 5px; vertical-align: middle }
  .badge-pdf { display: inline-block; background: #d1fae5; color: #065f46; font-size: 10px; font-weight: 700; padding: 1px 5px; border-radius: 3px; margin-left: 5px; vertical-align: middle; text-decoration: none }
  .badge-corr { display: inline-block; background: #fce7f3; color: #9d174d; font-size: 10px; font-weight: 700; padding: 1px 5px; border-radius: 3px; margin-left: 5px; vertical-align: middle }
  .badge-cofirst { display: inline-block; background: #ede9fe; color: #5b21b6; font-size: 10px; font-weight: 700; padding: 1px 5px; border-radius: 3px; margin-left: 5px; vertical-align: middle }

  .yr-sep { font-size: 12px; font-weight: 700; color: #6b7280; margin: 14px 0 6px; border-bottom: 1px solid var(--border); padding-bottom: 2px }

  .grant { margin-bottom: 9px; font-size: 13px; line-height: 1.6 }
  .grant .g-name { font-weight: 600; color: #111827 }
  .grant .g-meta { color: #4b5563; font-size: 12px }
  .g-badge { display: inline-block; background: #dbeafe; color: #1e40af; font-size: 11px; font-weight: 600; padding: 1px 7px; border-radius: 4px; margin-left: 6px }
  .g-badge-sub { background: #f0fdf4; color: #166534 }

  .rev-wrap { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px }
  .rev-tag { background: #f3f4f6; border: 1px solid var(--border); border-radius: 4px; padding: 2px 8px; font-size: 11.5px }

  @media print {
    @page { size: A4; margin: 18mm 18mm 20mm }
    body { background: #fff !important }
    header, footer, .print-btn { display: none !important }
    main { padding: 0 !important; max-width: 100% !important }
    .cv-wrap { max-width: 100% }
    .pub, .item, .grant { page-break-inside: avoid }
    .s-title { page-break-after: avoid }
    a { color: #111827 !important; text-decoration: none }
    .badge-hc, .badge-pdf { display: none }
  }
</style>


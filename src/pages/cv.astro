---
import Base from '../layouts/Base.astro'
import papers from '../../public-data/papers.json'
import patents from '../../public-data/patents.json'
import software from '../../public-data/software.json'
import standards from '../../public-data/standards.json'

const isFirstCorr = (p: any) =>
  ['first_author','first_or_corresponding','corresponding'].includes(p.author_role)

const firstCorrPapers = [...papers].filter(isFirstCorr).sort((a:any,b:any) => b.date?.localeCompare(a.date))
const coAuthorPapers  = [...papers].filter((p:any) => !isFirstCorr(p)).sort((a:any,b:any) => b.date?.localeCompare(a.date))

const firstPatents = (patents as any[]).filter(p => p.inventors?.[0]==='王岳'||p.inventors?.[0]==='Wang Yue')
const coPatents    = (patents as any[]).filter(p => p.inventors?.[0]!=='王岳'&&p.inventors?.[0]!=='Wang Yue')

function fmtName(name: string): string {
  if (name==='王岳') return '<strong>王岳</strong>'
  if (name==='Wang Yue') return '<strong>Yue Wang</strong>'
  const parts = name.trim().split(' ')
  if (parts.length===2) return `${parts[1]} ${parts[0]}`
  return name
}
function authorHtml(authors: string[]): string {
  const shown = authors.slice(0,10)
  const suffix = authors.length>10 ? ', <em>et al.</em>' : ''
  return shown.map(fmtName).join(', ') + suffix
}

function groupByYear(list: any[]): { yr: string; pubs: any[] }[] {
  const byYear: Record<string, any[]> = {}
  for (const p of list) {
    const yr = p.date?.slice(0,4) ?? 'n.d.'
    if (!byYear[yr]) byYear[yr] = []
    byYear[yr].push(p)
  }
  return Object.keys(byYear).sort((a,b) => b.localeCompare(a)).map(yr => ({ yr, pubs: byYear[yr] }))
}

// Pre-compute numbered first/corr papers with global index
const fcGroups = groupByYear(firstCorrPapers)
let fcIdx = firstCorrPapers.length
const fcGroupsNum = fcGroups.map(({ yr, pubs }) => ({
  yr,
  pubs: pubs.map(p => ({ ...p, num: fcIdx-- }))
}))
fcIdx = firstCorrPapers.length  // reset counter after use

// Pre-compute numbered co-author papers
const coGroups = groupByYear(coAuthorPapers)
let coIdx = coAuthorPapers.length
const coGroupsNum = coGroups.map(({ yr, pubs }) => ({
  yr,
  pubs: pubs.map(p => ({ ...p, num: coIdx-- }))
}))
